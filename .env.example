# ============================================
# DraftPilot Environment Variables
# Copy to .env and fill in your values
# ============================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- AI Provider ---
OPENAI_API_KEY=sk-your-openai-api-key
AI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=300

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_TEAM_PRICE_ID=price_your-team-plan-price-id

# --- App Config ---
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=chrome-extension://your-extension-id
FREE_TIER_MONTHLY_DRAFT_LIMIT=50

# --- Vercel BotID ---
# No env var needed in Vercel — BotID verification keys are injected
# automatically by the Vercel platform when the project has Bot
# Management enabled (Project → Settings → Security → Bot Management).
# On local dev, the botid package works in "monitor" mode without keys.
# BOTID_VERIFICATION_KEY=  # only set if running botid outside Vercel
